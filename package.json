    "fflate": "^0.8.3",
    "jsqr": "^1.4.0",
    "libheif-js": "^1.23.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.63.0",
